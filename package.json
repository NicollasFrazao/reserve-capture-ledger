{
  "name": "reserve-capture-ledger",
  "version": "0.1.0",
  "description": "Idempotent per-request billing on PostgreSQL: reserve, capture and release credits against an append-only ledger, safe under retries and concurrency.",
  "license": "MIT",
  "author": "Nícollas Frazão",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "migrate": "tsx src/infrastructure/migrate.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:tooling": "vitest run --project tooling",
    "check:architecture": "depcruise src test --config .dependency-cruiser.cjs",
    "check:context": "node scripts/check-context-surfaces.mjs",
    "export:context": "node scripts/check-context-surfaces.mjs --write",
    "prepare": "husky",
    "check:unused": "knip"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "knip": "6.44.1",
    "lint-staged": "17.6.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
